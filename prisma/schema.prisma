// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Supervisor {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]
}

model Character {
  id              String    @id @default(cuid())
  name            String
  inhouseProducts Product[] @relation("InhouseProducts")
  regions         Region[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Region {
  id          String     @id @default(cuid())
  name        String
  characterId String
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  licensees   Licensee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Licensee {
  id        String    @id @default(cuid())
  name      String
  regionId  String
  region    Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String       @id @default(cuid())
  name        String
  type        ReviewType
  status      ReviewStatus @default(PENDING)
  imageUrl    String?
  characterId String?
  character   Character?   @relation("InhouseProducts", fields: [characterId], references: [id], onDelete: Cascade)
  licenseeId  String?
  licensee    Licensee?    @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  comments    Comment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Comment {
  id           String      @id @default(cuid())
  body         String
  supervisorId String?
  supervisor   Supervisor? @relation(fields: [supervisorId], references: [id])
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum ReviewType {
  DESIGN
  SAMPLE
}

enum ReviewStatus {
  PENDING
  IN_REVIEW
  REVISION_NEEDED
  APPROVED
  COMPLETED
}
