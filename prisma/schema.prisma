generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Character {
  id                   String    @id @default(cuid())
  name                 String
  requiresAuthorReview Boolean   @default(false)
  products             Product[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Licensee {
  id        String    @id @default(cuid())
  name      String
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String        @id @default(cuid())
  name        String
  characterId String
  character   Character     @relation(fields: [characterId], references: [id])
  licenseeId  String?
  licensee    Licensee?     @relation(fields: [licenseeId], references: [id])
  isCompleted Boolean       @default(false)
  stages      ReviewStage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ReviewStage {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  stageType    StageType
  satoStatus   SatoStatus   @default(PENDING)
  satoNote     String?
  authorStatus AuthorStatus @default(NOT_REQUIRED)
  authorNote   String?
  fileUrl      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([productId, stageType])
}

enum StageType {
  DESIGN_1
  DESIGN_2
  SAMPLE_1
  SAMPLE_2
}

enum SatoStatus {
  PENDING
  IN_REVIEW
  REVISION_NEEDED
  APPROVED
}

enum AuthorStatus {
  NOT_REQUIRED
  PENDING
  IN_REVIEW
  REVISION_NEEDED
  APPROVED
}
